# ==========================================
# SERVER & DATABASE CONFIGURATION
# ==========================================
NODE_ENV=development
PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecombd?schema=public"

# ==========================================
# BETTER AUTH CONFIGURATION
# ==========================================
BETTER_AUTH_SECRET="your-better-auth-secret-key-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:5000"
BETTER_AUTH_SESSION_TOKEN_EXPIRES_IN="7d"
BETTER_AUTH_SESSION_TOKEN_UPDATE_AGE="1d"

# ==========================================
# FRONTEND & OAUTH CONFIGURATION
# ==========================================
FRONTEND_URL="http://localhost:3000"

GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:5000/api/auth/callback/google"

# ==========================================
# SMTP EMAIL CONFIGURATION (NODEMAILER)
# ==========================================
EMAIL_SENDER_SMTP_USER="your-email@gmail.com"
EMAIL_SENDER_SMTP_PASS="your-app-password"
EMAIL_SENDER_SMTP_HOST="smtp.gmail.com"
EMAIL_SENDER_SMTP_PORT="465"
EMAIL_SENDER_SMTP_FROM="EcomBD Footwear <your-email@gmail.com>"

# ==========================================
# CLOUDINARY STORAGE CONFIGURATION
# ==========================================
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ==========================================
# DEFAULT SUPER ADMIN SEED CREDENTIALS
# ==========================================
ADMIN_EMAIL="admin@ecombd.com"
ADMIN_PASSWORD="AdminPassword123!"

# ==========================================
# BANGLADESH COURIER INTEGRATIONS (OPTIONAL)
# ==========================================
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""
STEADFAST_BASE_URL="https://portal.packzy.com/api/v1"

PATHAO_CLIENT_ID=""
PATHAO_CLIENT_SECRET=""
PATHAO_USERNAME=""
PATHAO_PASSWORD=""
PATHAO_BASE_URL="https://api-hermes.pathao.com"

REDX_ACCESS_TOKEN=""
REDX_BASE_URL="https://openapi.redx.com.bd/v1.0.0-beta"

FRAUD_CHECKER_API_KEY=""

# ==========================================
# PAYMENT GATEWAYS - BD (OPTIONAL)
# ==========================================
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"

SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
